// Minimal Waybar configuration (flush top bar, 3 sharp-cornered islands, GTK4 Windows-style flyouts)
// Switch between 'minimal' and 'full' anytime via:
//   ~/nixos/home-config/ryan/scripts/waybar-switch.sh
{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "group/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/system"
    ],

    // ============ LEFT: WORKSPACES ISLAND ============
    // Left-click: switch workspace  |  Right-click: compress occupied workspaces (1..N)
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspace-1",
            "custom/workspace-2",
            "custom/workspace-3",
            "custom/workspace-4"
        ]
    },

    "custom/workspace-1": {
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 1",
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 1",
        "on-click-right": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-compress.sh"
    },

    "custom/workspace-2": {
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 2",
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 2",
        "on-click-right": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-compress.sh"
    },

    "custom/workspace-3": {
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 3",
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 3",
        "on-click-right": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-compress.sh"
    },

    "custom/workspace-4": {
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 4",
        "return-type": "json",
        "format": "{text}",
        "tooltip": true,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 4",
        "on-click-right": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-compress.sh"
    },

    // ============ CENTER: CLOCK ISLAND ============
    "clock": {
        "interval": 60,
        "format": "{:%a %b %d   %I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cdd6f4'><b>{}</b></span>",
                "days": "<span color='#a6adc8'>{}</span>",
                "weeks": "<span color='#6c7086'>[{}]</span>",
                "weekdays": "<span color='#7f849c'><b>{}</b></span>",
                "today": "<span color='#89b4fa'><b><u>{}</u></b></span>"
            }
        }
    },

    // ============ RIGHT: UNIFIED SYSTEM TRAY ISLAND ============
    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "custom/hwmon",
            "group/quick",
            "battery"
        ]
    },

    // All hardware monitoring (CPU, RAM, Temps, Fan) condensed into a single clickable icon
    "custom/hwmon": {
        "interval": 5,
        "exec": "bash /home/ryan/nixos/home-config/ryan/scripts/stats/hwmon-pill.sh",
        "return-type": "json",
        "format": "{text}",
        "on-click": "bash /home/ryan/nixos/home-config/ryan/scripts/flyout/flyout-ctl.sh toggle hwmon",
        "on-click-right": "wezterm start --class stats-tui -- bash /home/ryan/nixos/home-config/ryan/scripts/stats/stats-tui.sh"
    },

    // Merged Windows-style Quick Settings cluster (Wi-Fi + Audio, click opens Quick Settings flyout)
    "group/quick": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "pulseaudio"
        ]
    },

    "network": {
        "interval": 10,
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤭",
        "tooltip-format-wifi": "{essid} · {signalStrength}% ({frequency} GHz)\nIP: {ipaddr}/{cidr}\nLeft-click: Quick Settings  ·  Right-click: Toggle Wi-Fi",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}\nLeft-click: Quick Settings",
        "tooltip-format-disconnected": "Offline\nLeft-click: Quick Settings  ·  Right-click: Toggle Wi-Fi",
        "on-click": "bash /home/ryan/nixos/home-config/ryan/scripts/flyout/flyout-ctl.sh toggle quick",
        "on-click-right": "rfkill toggle wifi"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        "on-click": "bash /home/ryan/nixos/home-config/ryan/scripts/flyout/flyout-ctl.sh toggle quick",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc} · {volume}%\nScroll: Volume  ·  Left-click: Quick Settings  ·  Right-click: Mute"
    },

    "battery": {
        "interval": 15,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "hyprctl notify 0 4000 'rgb(f9e2af)' 'Charge your damn computer'",
            "on-discharging-critical": "hyprctl notify 1 10000 'rgb(f38ba8)' 'PLUG ME IN BEFORE YOU KILL ME'",
            "on-charging-100": "hyprctl notify 0 2000 'rgb(a6e3a1)' 'ur good fam'"
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-time": "{H}h {M}m",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "on-click": "bash /home/ryan/nixos/home-config/ryan/scripts/flyout/flyout-ctl.sh toggle power",
        "on-click-right": "bash /home/ryan/nixos/home-config/ryan/scripts/power/power-toggle.sh",
        "tooltip-format": "Battery {capacity}% ({time}) · {power:.1f}W\nLeft-click: Power Flyout  ·  Right-click: Cycle Profile"
    }
}
