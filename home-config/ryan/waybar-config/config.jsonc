// config.jsonc, symlinked to ~/.config/waybar

// left clicking should always be control station / more info
// right clicking should always be toggle power / status
{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 4,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,

    "modules-left": [
        "group/workspaces",
        "custom/compress-workspaces",
        "pulseaudio#speaker",
        "pulseaudio#microphone",
        "bluetooth",
        "network",
        "custom/fan-menu",
        "custom/power-menu",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "idle_inhibitor",
        "backlight",
        "group/stats",
        "battery"
        // "tray"
    ],

    // this Hyprland fork dispatches via its Lua API (hl.dsp.*), which the compiled
    // hyprland/workspaces module's built-in click handler doesn't speak -- so we
    // drive workspace switching ourselves via workspace-switch.sh instead
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspace-1",
            "custom/workspace-2",
            "custom/workspace-3",
            "custom/workspace-4"
        ]
    },

    // "interval": "once" + "signal": 8 -- workspace-listener.sh (started by
    // Hyprland on login) watches Hyprland's event socket and sends SIGRTMIN+8
    // to waybar only when the active workspace actually changes, so these no
    // longer poll on a 0.3s timer (that was the single biggest battery drain
    // in this config: ~27 process forks/sec, enough to keep the CPU out of
    // deep idle continuously)
    "custom/workspace-1": {
        "min-length": 1,
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 1",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 1"
    },

    "custom/workspace-2": {
        "min-length": 1,
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 2",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 2"
    },

    "custom/workspace-3": {
        "min-length": 1,
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 3",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 3"
    },

    "custom/workspace-4": {
        "min-length": 1,
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 4",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 4"
    },

    // packs occupied workspaces down to 1, 2, 3... closing gaps left by
    // empty ones (windows on 2 and 4 become 1 and 2)
    "custom/compress-workspaces": {
        "min-length": 1,
        "tooltip": true,
        "tooltip-format": "Compress workspaces",
        "format": "",
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-compress.sh"
    },

    // "hyprland/window": {
    //     "format": "{class} | {title}",
    //     "max-length": 80,
    //     "separate-outputs": true,
    //     "rewrite": {
    //         "(.*) - Mozilla Firefox": "$1",
    //         "(.*) — Mozilla Firefox": "$1"
    //     }
    // },



    // GET AUDIO DEVICES:
    // wpctl list-devices
    // pipe into less, search for Mic or speaker (or sink)
    // last call was:
    // id 64 is builtin HiFi speaker
    // id 65 is builtin stereo mic (dont use)
    // id 66 is builtin digital mic
    //

    "pulseaudio#speaker": {
        "min-length": 6,
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 1,
        "on-click": "wezterm start --class wiremix -- wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}\nVolume: {volume}%"
    },

    "pulseaudio#microphone": {
        "min-length": 6,
        "format": "{format_source}",
        "format-source": " ready",
        "format-source-muted": "  muted",
        "on-click": "wezterm start --class wiremix -- wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "tooltip": true
    },

    "bluetooth": {
        "controller": "tpacpi_bluetooth_sw",  // thinkpad wifi controller ( rfkill )
        "min-length": 3,
        "interval": 2,
        "format": "󰂯 {status}",
        "format-disabled": "󰂲 off",
        "format-connected": "󰂱  {num_connections}",
        "format-no-controller": "...",
        "tooltip-format": "Controller: {controller_alias} ({controller_address})\nConnected devices: {num_connections}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  · {device_alias} ({device_address})",
        "tooltip-format-enumerate-connected-battery": "  · {device_alias} ({device_address}) — {device_battery_percentage}%",
        "on-click": "wezterm start --class bluetuith -- bluetuith",
        "on-click-right": "rfkill toggle bluetooth"
    },


    "network": {
        "interval": 3,
        "min-length": 10,
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  wired",
        "format-disconnected": "󰤭  offline...",
        "format-disabled": "󰤭  disabled",
        "tooltip-format-wifi": "{essid} · {signalStrength}% signal ({signaldBm} dBm)\nFreq: {frequency} GHz\n\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\nNetmask: {netmask}\nMAC (BSSID): {bssid}\n\n↓ {bandwidthDownBits}   ↑ {bandwidthUpBits}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\n↓ {bandwidthDownBits}   ↑ {bandwidthUpBits}",
        "tooltip-format-disconnected": "Disconncted",
        // nmtui run bare had nothing to draw into -- waybar has no TTY, so the
        // previous on-click was silently going nowhere. Open it in a wezterm
        // window instead, same as the bluetooth/audio TUIs below.
        "on-click": "wezterm start --class nmtui -- nmtui",
        "on-click-right": "rfkill toggle wifi"
    },

    "custom/fan-menu": {
        "min-length": 6,
        "interval": 10,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/fan/fan-status.sh",
        "return-type": "json",
        "format": "{text}",
        "menu": "on-click",
        "menu-file": "/home/ryan/nixos/home-config/ryan/waybar-config/menus/fan-menu.xml",
        "menu-actions": {
            "quiet": "/home/ryan/nixos/home-config/ryan/scripts/fan/fan-quiet.sh",
            "auto": "/home/ryan/nixos/home-config/ryan/scripts/fan/fan-auto.sh",
            "max": "/home/ryan/nixos/home-config/ryan/scripts/fan/fan-max.sh"
        }
    },

    "custom/power-menu": {
        "min-length": 6,
        "interval": 2,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/power/power-status.sh",
        "return-type": "json",
        "format": "{text}",
        "menu": "on-click",
        "menu-file": "/home/ryan/nixos/home-config/ryan/waybar-config/menus/power-menu.xml",
        "menu-actions": {
            "performance": "/home/ryan/nixos/home-config/ryan/scripts/power/power-performance.sh",
            "balanced": "/home/ryan/nixos/home-config/ryan/scripts/power/power-balanced.sh",
            "saver": "/home/ryan/nixos/home-config/ryan/scripts/power/power-saver.sh"
        }
    },

    // now-playing; shows nothing when no player is active
    "mpris": {
        "interval": 1,
        "format": "{status_icon} {dynamic}",
        "format-stopped": "",
        "status-icons": {
            "playing": "▶",
            "paused": "⏸",
            "stopped": ""
        },
        "title-len": 22,
        "artist-len": 16,
        "dynamic-len": 36,
        "dynamic-order": ["title", "artist"],
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player}: {dynamic}"
    },

    "clock": {
        "interval": 60,
        "format": "{:%A  ·  %I:%M %p  ·  %B %d}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "days": "{}",
                "weeks": "<span color='#a6adc8'>[{}]</span>",
                "weekdays": "<span color='#a6adc8'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        }
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Idle inhibitor: on (screen stays awake)",
        "tooltip-format-deactivated": "Idle inhibitor: off"
    },

    "backlight": {
        "interval": 2,
        "min-length": 5,
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "reverse-scrolling": true,
        "tooltip-format": "Backlight: {percent}%\nscroll to adjust"
    },

    "group/stats": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "temperature"
        ]
    },

    "cpu": {
        "interval": 2,
        "min-length": 10,
        "format": "󰘚 {usage:>2}%",
        "tooltip-format": "Load: {load}\nFreq: {min_frequency}-{max_frequency} GHz (avg {avg_frequency} GHz)\n\n{usage0:>3}% {usage1:>3}% {usage2:>3}% {usage3:>3}% {usage4:>3}%\n{usage5:>3}% {usage6:>3}% {usage7:>3}% {usage8:>3}% {usage9:>3}%\n{usage10:>3}% {usage11:>3}% {usage12:>3}% {usage13:>3}% {usage14:>3}%\n{usage15:>3}% {usage16:>3}% {usage17:>3}% {usage18:>3}% {usage19:>3}%"
    },

    "memory": {
        "interval": 3,
        "min-length": 9,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nAvailable: {avail:0.1f} GiB\n\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB ({swapPercentage}%)"
    },

    "temperature": {
        "interval": 3,
        "min-length": 8,
        "thermal-zone": 8,
        "critical-threshold": 80,
        "format": "󰔏  {temperatureC}°C",
        "format-critical": "󰸁  {temperatureC}°C",
        "tooltip-format": "{temperatureC}°C · {temperatureF}°F · {temperatureK}K\nCritical threshold: 80°C"
    },

    "battery": {
        "interval": 2,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": { // 0 = warning, second 0 is default color for warning
            "on-discharging-warning": "hyprctl notify 0 4000 0 'Charge your damn computer'",
            "on-discharging-critical": "hyprctl notify 1 10000 1 'PLUG ME IN BEFORE YOU KILL ME'",
            "on-charging-100": "hyprctl notify 0 2000 0 'ur good fam'"
        },
        "full-at": 85, // STOP_CHARGE_THRESH_BAT0
        "min-length": 14,
        "format": "{icon} {capacity}% {power:.0f}W",
        "format-charging": "{icon} {capacity}% +{power:.0f}W",
        "format-time": "{H}:{m}",
        "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
        ],
        "tooltip-format": "{capacity}% · {time} remaining\nDraw: {power:.1f}W\n\nCycles: {cycles}\nHealth: {health}%"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 6
    }
}
