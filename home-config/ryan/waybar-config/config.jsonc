// config.jsonc, symlinked to ~/.config/waybar

// left clicking should always be control station / more info
// right clicking should always be toggle power / status
{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 4,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,

    "modules-left": [
        "group/workspaces",
        "group/media",
        "group/connectivity"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/display",
        "group/stats",
        "group/power"
    ],

    // ============ LEFT: WORKSPACES ISLAND (accent: blue) ============
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspace-1",
            "custom/workspace-2",
            "custom/workspace-3",
            "custom/workspace-4",
            "custom/compress-workspaces"
        ]
    },

    "custom/workspace-1": {
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 1",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 1"
    },

    "custom/workspace-2": {
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 2",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 2"
    },

    "custom/workspace-3": {
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 3",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 3"
    },

    "custom/workspace-4": {
        "interval": "once",
        "signal": 8,
        "exec": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-button-status.sh 4",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-switch.sh 4"
    },

    "custom/compress-workspaces": {
        "tooltip": true,
        "tooltip-format": "Compress occupied workspaces (1..N)",
        "format": "󰡍",
        "on-click": "/home/ryan/nixos/home-config/ryan/scripts/workspace/workspace-compress.sh"
    },

    // ============ LEFT: MEDIA & AUDIO ISLAND (accent: mauve) ============
    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio#speaker",
            "pulseaudio#microphone",
            "mpris"
        ]
    },

    "pulseaudio#speaker": {
        "format": "{icon} {volume}%",
        "min-length": 9,
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 1,
        "on-click": "wezterm start --class wiremix -- wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}\nSpeaker volume: {volume}%"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "min-length": 9,
        "format-source": "󰍬 ready",
        "format-source-muted": "󰍭 muted",
        "on-click": "wezterm start --class wiremix -- wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "tooltip-format": "Microphone: {source_desc}\nInput level: {source_volume}%"
    },

    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-stopped": "",
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤",
            "stopped": ""
        },
        "title-len": 22,
        "artist-len": 16,
        "dynamic-len": 34,
        "dynamic-order": ["title", "artist"],
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player}: {dynamic}"
    },

    // ============ LEFT: CONNECTIVITY ISLAND (accent: teal) ============
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "custom/dns-menu",
            "bluetooth"
        ]
    },

    "custom/dns-menu": {
        "interval": 10,
        "signal": 11,
        "exec": "bash /home/ryan/nixos/home-config/ryan/scripts/dns/dns-status.sh",
        "return-type": "json",
        "format": "{text}",
        "on-click-right": "bash /home/ryan/nixos/home-config/ryan/scripts/dns/dns-toggle.sh",
        "menu": "on-click",
        "menu-file": "/home/ryan/nixos/home-config/ryan/waybar-config/menus/dns-menu.xml",
        "menu-actions": {
            "off": "bash /home/ryan/nixos/home-config/ryan/scripts/dns/dns-off.sh",
            "direct": "bash /home/ryan/nixos/home-config/ryan/scripts/dns/dns-direct.sh",
            "tor": "bash /home/ryan/nixos/home-config/ryan/scripts/dns/dns-tor.sh"
        }
    },

    "network": {
        "interval": 10,
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 wired",
        "format-disconnected": "󰤭 offline",
        "format-disabled": "󰤭 off",
        "tooltip-format-wifi": "󰤨  {essid} · {signalStrength}% ({signaldBm} dBm · {frequency} GHz)\nIP: {ipaddr}/{cidr} · GW: {gwaddr}\n↓ {bandwidthDownBits}   ↑ {bandwidthUpBits}",
        "tooltip-format-ethernet": "󰈀  {ifname}\nIP: {ipaddr}/{cidr}\n↓ {bandwidthDownBits}   ↑ {bandwidthUpBits}",
        "tooltip-format-disconnected": "Network disconnected",
        "on-click": "wezterm start --class nmtui -- nmtui",
        "on-click-right": "rfkill toggle wifi"
    },

    "bluetooth": {
        "controller": "tpacpi_bluetooth_sw",
        "interval": 10,
        "format": "󰂯 {status}",
        "format-on": "󰂯 on",
        "format-off": "󰂲 off",
        "format-disabled": "󰂲 off",
        "format-connected": "󰂱 {num_connections}",
        "format-no-controller": "󰂲 off",
        "tooltip-format": "󰂯  Bluetooth ({status})\nController: {controller_alias} ({controller_address})\nConnected: {num_connections}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  · {device_alias} ({device_address})",
        "tooltip-format-enumerate-connected-battery": "  · {device_alias} ({device_address}) — {device_battery_percentage}%",
        "on-click": "wezterm start --class bluetuith -- bluetuith",
        "on-click-right": "rfkill toggle bluetooth"
    },

    // ============ CENTER: CLOCK ISLAND (accent: text / blue) ============
    "clock": {
        "interval": 60,
        "format": "󰃰  {:%a %b %d  ·  %I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "weeks": "<span color='#6c7086'>[{}]</span>",
                "weekdays": "<span color='#a6adc8'><b>{}</b></span>",
                "today": "<span color='#a6e3a1'><b><u>{}</u></b></span>"
            }
        }
    },

    // ============ RIGHT: DISPLAY ISLAND (accent: yellow) ============
    "group/display": {
        "orientation": "horizontal",
        "modules": [
            "idle_inhibitor",
            "backlight"
        ]
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈 awake",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Idle inhibitor: ON (screen stays awake)",
        "tooltip-format-deactivated": "Idle inhibitor: OFF (normal dim/sleep)"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "reverse-scrolling": true,
        "tooltip-format": "Display backlight: {percent}%\nScroll to adjust"
    },

    // ============ RIGHT: HARDWARE & THERMALS ISLAND (accent: sapphire) ============
    "group/stats": {
        "orientation": "horizontal",
        "modules": [
            "custom/cpu",
            "custom/memory",
            "custom/temperature",
            "custom/fan-menu"
        ]
    },

    "custom/cpu": {
        "interval": 5,
        "exec": "bash /home/ryan/nixos/home-config/ryan/scripts/stats/cpu-status.sh",
        "return-type": "json",
        "format": "{text}",
        "on-click": "wezterm start --class stats-tui -- bash /home/ryan/nixos/home-config/ryan/scripts/stats/stats-tui.sh",
        "on-click-right": "wezterm start --class btop -- btop"
    },

    "custom/memory": {
        "interval": 10,
        "exec": "bash /home/ryan/nixos/home-config/ryan/scripts/stats/memory-status.sh",
        "return-type": "json",
        "format": "{text}",
        "on-click": "wezterm start --class stats-tui -- bash /home/ryan/nixos/home-config/ryan/scripts/stats/stats-tui.sh",
        "on-click-right": "wezterm start --class btop -- btop"
    },

    "custom/temperature": {
        "interval": 8,
        "exec": "bash /home/ryan/nixos/home-config/ryan/scripts/stats/temperature-status.sh",
        "return-type": "json",
        "format": "{text}",
        "on-click": "wezterm start --class stats-tui -- bash /home/ryan/nixos/home-config/ryan/scripts/stats/stats-tui.sh"
    },

    "custom/fan-menu": {
        "interval": 10,
        "signal": 10,
        "exec": "bash /home/ryan/nixos/home-config/ryan/scripts/fan/fan-status.sh",
        "return-type": "json",
        "format": "{text}",
        "on-click-right": "bash /home/ryan/nixos/home-config/ryan/scripts/fan/fan-toggle.sh",
        "menu": "on-click",
        "menu-file": "/home/ryan/nixos/home-config/ryan/waybar-config/menus/fan-menu.xml",
        "menu-actions": {
            "quiet": "/home/ryan/nixos/home-config/ryan/scripts/fan/fan-quiet.sh",
            "auto": "/home/ryan/nixos/home-config/ryan/scripts/fan/fan-auto.sh",
            "max": "/home/ryan/nixos/home-config/ryan/scripts/fan/fan-max.sh"
        }
    },

    // ============ RIGHT: POWER & BATTERY ISLAND (accent: green / sapphire / peach) ============
    "group/power": {
        "orientation": "horizontal",
        "modules": [
            "custom/power-menu",
            "custom/battery-changes",
            "battery"
        ]
    },

    "custom/power-menu": {
        "interval": "once",
        "signal": 9,
        "exec": "bash /home/ryan/nixos/home-config/ryan/scripts/power/power-status.sh",
        "return-type": "json",
        "format": "{text}",
        "on-click-right": "bash /home/ryan/nixos/home-config/ryan/scripts/power/power-toggle.sh",
        "menu": "on-click",
        "menu-file": "/home/ryan/nixos/home-config/ryan/waybar-config/menus/power-menu.xml",
        "menu-actions": {
            "performance": "/home/ryan/nixos/home-config/ryan/scripts/power/power-performance.sh",
            "balanced": "/home/ryan/nixos/home-config/ryan/scripts/power/power-balanced.sh",
            "saver": "/home/ryan/nixos/home-config/ryan/scripts/power/power-saver.sh"
        }
    },

    // Live BAT / AC optimizations pill; hover for highlighted comparison or left-click for TUI
    "custom/battery-changes": {
        "interval": 15,
        "signal": 9,
        "exec": "bash /home/ryan/nixos/home-config/ryan/scripts/power/battery-changes.sh",
        "return-type": "json",
        "format": "{text}",
        "on-click": "wezterm start --class battery-changes -- bash /home/ryan/nixos/home-config/ryan/scripts/power/battery-changes.sh --interactive",
        "on-click-right": "bash /home/ryan/nixos/home-config/ryan/scripts/power/power-toggle.sh"
    },

    "battery": {
        "interval": 15,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "hyprctl notify 0 4000 0 'Charge your damn computer'",
            "on-discharging-critical": "hyprctl notify 1 10000 1 'PLUG ME IN BEFORE YOU KILL ME'",
            "on-charging-100": "hyprctl notify 0 2000 0 'ur good fam'"
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}% · +{power:.1f}W",
        "format-plugged": "󰚥 {capacity}%",
        "format-time": "{H}h {M}m",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "on-click": "wezterm start --class battery-changes -- bash /home/ryan/nixos/home-config/ryan/scripts/power/battery-changes.sh --interactive",
        "on-click-right": "bash /home/ryan/nixos/home-config/ryan/scripts/power/power-toggle.sh",
        "tooltip-format": "Battery: {capacity}% ({time})\nPower draw: {power:.1f}W\nCycles: {cycles} · Health: {health}%\n(Left-click: Power Optimizations TUI)"
    }
}
